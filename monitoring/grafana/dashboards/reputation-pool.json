      "fieldConfig": {
        "defaults": {
          "unit": "epm",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(reputation_pool_checkpoint_failures_total[5m])) * 60",
          "legendFormat": "체크포인트 저장 실패"
        },
        {
          "refId": "B",
          "expr": "sum(rate(reputation_pool_restore_failures_total[5m])) * 60",
          "legendFormat": "기동 시 복원 실패"
