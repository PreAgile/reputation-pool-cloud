# Copy to .env for local development: `cp .env.example .env` (`.env` is gitignored — never commit it).
# Docker Compose loads .env automatically. In production these come from a secret store, not a file.

# REQUIRED — the gRPC API key clients send in the x-api-key metadata header. There is deliberately no
# default: a fallback would leave a known key accepting calls on the public API. Use a strong random
# value in production; this local placeholder is only for `docker compose up` on a dev machine.
REPUTATION_POOL_API_KEY=local-dev-key

# REQUIRED — the Grafana admin password (#14 monitoring stack). No default on purpose: a fallback would
# boot Grafana with a known admin/admin login. Use a strong random value in production; this local
# placeholder is only for `docker compose up` on a dev machine.
GRAFANA_ADMIN_PASSWORD=local-dev-admin

# Optional — the DB password. compose falls back to a local throwaway for the internal db container
# if unset; set it here (and it is injected into both app and db) to use your own.
# REPUTATION_POOL_DB_PASSWORD=reputation_pool

# Optional — REST control-plane admin login (issue #11). Unset leaves the admin console disabled (fail
# closed): POST /api/auth/login cannot mint a token and every /api/** call is rejected, while the gRPC
# data plane still works. Set all three to enable it. The JWT secret MUST be at least 32 bytes (HS256
# needs a 256-bit key); use a strong random value in production, not this local placeholder.
# REPUTATION_POOL_ADMIN_USERNAME=admin
# REPUTATION_POOL_ADMIN_PASSWORD=change-me-local-dev
# REPUTATION_POOL_ADMIN_JWT_SECRET=0123456789abcdef0123456789abcdef

# Optional value, but the variable itself must stay DEFINED — leave it empty to disable (#76, SLO alert
# routing). Empty means the default receiver has zero integrations (a no-op blackhole): Alertmanager still
# groups/dedups firing alerts but sends them nowhere. To route SLO alerts to a real endpoint, put the URL
# here and uncomment the webhook_configs block in monitoring/alertmanager.yml
# (e.g. REPUTATION_POOL_ALERTMANAGER_WEBHOOK_URL=https://example.com/alertmanager-webhook). The value is
# mounted into the container as a file (compose secrets, environment source) and read via url_file — never
# embedded in the committed alertmanager.yml.
#
# Why this one is not commented out like the other optional vars: compose's `secrets: <name>: environment:`
# source resolves at container-create time and hard-fails on an *undefined* variable ("environment variable
# ... required by file ... is not set") — `docker compose config` still passes, so the failure only shows up
# on `up`. An empty value is fine (compose mounts an empty file); only a missing definition breaks the stack.
REPUTATION_POOL_ALERTMANAGER_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Production deploy only (issue #15) — used by compose.prod.yaml, not by local `docker compose up`.
# See docs/engineering/deployment.md.
# ---------------------------------------------------------------------------

# REQUIRED on a deploy host — the hostname Caddy serves and requests a certificate for, and the ACME
# account address that receives expiry/failure notices. compose.prod.yaml fails fast if either is unset,
# because an empty site address surfaces as a certificate error whose cause is hard to find.
# DOMAIN=app.example.com
# ACME_EMAIL=you@example.com

# Optional — pin the published image instead of tracking `latest`. Rollback path: set these to the
# sha-<commit> tag that release.yml published and re-run scripts/bootstrap.sh.
# APP_IMAGE_TAG=latest
# DASHBOARD_IMAGE_TAG=latest
