# Copy to .env for local development: `cp .env.example .env` (`.env` is gitignored — never commit it).
# Docker Compose loads .env automatically. In production these come from a secret store, not a file.

# REQUIRED — the gRPC API key clients send in the x-api-key metadata header. There is deliberately no
# default: a fallback would leave a known key accepting calls on the public API. Use a strong random
# value in production; this local placeholder is only for `docker compose up` on a dev machine.
REPUTATION_POOL_API_KEY=local-dev-key

# REQUIRED — the Grafana admin password (#14 monitoring stack). No default on purpose: a fallback would
# boot Grafana with a known admin/admin login. Use a strong random value in production; this local
# placeholder is only for `docker compose up` on a dev machine.
GRAFANA_ADMIN_PASSWORD=local-dev-admin

# Optional — the DB password. compose falls back to a local throwaway for the internal db container
# if unset; set it here (and it is injected into both app and db) to use your own.
# REPUTATION_POOL_DB_PASSWORD=reputation_pool

# Optional — REST control-plane admin login (issue #11). Unset leaves the admin console disabled (fail
# closed): POST /api/auth/login cannot mint a token and every /api/** call is rejected, while the gRPC
# data plane still works. Set all three to enable it. The JWT secret MUST be at least 32 bytes (HS256
# needs a 256-bit key); use a strong random value in production, not this local placeholder.
# REPUTATION_POOL_ADMIN_USERNAME=admin
# REPUTATION_POOL_ADMIN_PASSWORD=change-me-local-dev
# REPUTATION_POOL_ADMIN_JWT_SECRET=0123456789abcdef0123456789abcdef

# Optional — read-only demo logins, one per audience the console is shown to. Each token carries
# scope=viewer: every GET/HEAD under /api/** is allowed and every other method is rejected with 403, so
# a viewer can display the console but never change state — the admin pair above stays the only way to
# block a resource, mint an API key, or touch a tenant lifecycle. Uses the same JWT secret as admin.
#
# Four fixed slots (0-3); unset slots are ignored, so an empty list means no viewer token is ever minted.
# _TENANT is optional and falls back to REPUTATION_POOL_ADMIN_TENANT. Point it at a tenant holding
# demonstration data — otherwise the demo lands on whatever tenant the operator console is running,
# whose read model contains real resource identifiers.
# REPUTATION_POOL_ADMIN_VIEWERS_0_USERNAME=demo
# REPUTATION_POOL_ADMIN_VIEWERS_0_PASSWORD=demo
# REPUTATION_POOL_ADMIN_VIEWERS_0_TENANT=default

# Optional — domain-surge alert thresholds (#77), in transitions per minute. The app publishes these as
# gauges and monitoring/alerts.yml compares observed rates against them, because Prometheus does not expand
# environment variables inside rule files. Both defaults are an unmeasured hypothesis; what is derived is
# their ratio (BLOCKED cools for 7200s vs 60s for SLOW, so the same per-minute figure means a far bigger
# event for BLOCKED). Tune once real traffic is observed — see monitoring/README.md "급증 임계값 조정" for
# the procedure. Must be > 0: to switch a rule off, remove it from alerts.yml.
# REPUTATION_POOL_COOLING_SURGE_THRESHOLD=10
# REPUTATION_POOL_BLOCKING_SURGE_THRESHOLD=1

# Optional value, but the variable itself must stay DEFINED — leave it empty to disable (#76, SLO alert
# routing). Empty means the default receiver has zero integrations (a no-op blackhole): Alertmanager still
# groups/dedups firing alerts but sends them nowhere. To route SLO alerts to a real endpoint, put the URL
# here and uncomment the webhook_configs block in monitoring/alertmanager.yml
# (e.g. REPUTATION_POOL_ALERTMANAGER_WEBHOOK_URL=https://example.com/alertmanager-webhook). The value is
# mounted into the container as a file (compose secrets, environment source) and read via url_file — never
# embedded in the committed alertmanager.yml.
#
# Why this one is not commented out like the other optional vars: compose's `secrets: <name>: environment:`
# source resolves at container-create time and hard-fails on an *undefined* variable ("environment variable
# ... required by file ... is not set") — `docker compose config` still passes, so the failure only shows up
# on `up`. An empty value is fine (compose mounts an empty file); only a missing definition breaks the stack.
REPUTATION_POOL_ALERTMANAGER_WEBHOOK_URL=

# Optional — per-tenant request ceiling on the data plane (#132). Unset uses the app defaults
# (10 req/s sustained, burst 50 per tenant). Those numbers are an unmeasured hypothesis and are set
# generously on purpose: a ceiling that is too low silently throttles the first real customer — which
# is us (#137) — and that failure reads as "the product is slow", not as a limiter doing its job.
# Tune down once real traffic is observed.
#
# ENABLED=false is the escape hatch. It makes the limiter a no-op without a rebuild, for when the
# limiter itself is suspected of blocking healthy traffic. Rejections are counted at
# `datapane.rate.limited` and alerted on (monitoring/alerts.yml).
# REPUTATION_POOL_RATE_LIMIT_ENABLED=true
# REPUTATION_POOL_RATE_LIMIT_REQUESTS_PER_SECOND=10
# REPUTATION_POOL_RATE_LIMIT_BURST=50
# 한 테넌트가 동시에 열어 둘 수 있는 SubscribeEvents 스트림 수. 토큰 버킷은 "호출"을 세는데
# 서버 스트리밍 호출은 아무리 오래 살아도 호출 하나라, 이 축은 따로 막아야 한다.
# REPUTATION_POOL_RATE_LIMIT_MAX_CONCURRENT_STREAMS=20

# ---------------------------------------------------------------------------
# Production deploy only (issue #15) — used by compose.prod.yaml, not by local `docker compose up`.
# See docs/engineering/deployment.md.
# ---------------------------------------------------------------------------

# REQUIRED on a deploy host — the hostname Caddy serves and requests a certificate for, and the ACME
# account address that receives expiry/failure notices. compose.prod.yaml fails fast if either is unset,
# because an empty site address surfaces as a certificate error whose cause is hard to find.
# DOMAIN=app.example.com
# ACME_EMAIL=you@example.com

# Optional — the origin of the landing site the dashboard redirects to (default https://poolroost.com).
# This is NOT the dashboard's own origin: since issue #15 the landing (`/`, `/ko`) and docs (`/docs*`) live
# in a separate app (`landing/`, Cloudflare Pages on the apex), so the dashboard no longer serves marketing
# at all. What it does instead is 301 those old URLs to the apex, and this variable is that redirect target
# (dashboard/lib/site.ts → `LANDING_ORIGIN`, consumed by dashboard/next.config.ts `redirects()`).
# It replaces the former NEXT_PUBLIC_SITE_URL, which had no consumer left once the marketing pages moved.
#
# Unlike every other variable in this file, this one is NOT read by the running container: it is a
# **build-time** var. Next inlines `NEXT_PUBLIC_*` and bakes redirect rules into the route manifest during
# `next build`, so the value is frozen when the image is built — release.yml passes it to `docker build` as
# a build arg (see dashboard/Dockerfile). Putting it in the deploy host's .env would do nothing. To change
# it without touching code, set a repository/environment variable `NEXT_PUBLIC_LANDING_URL` in GitHub Actions.
# A wrong value fails silently and expensively: the old, already-indexed marketing URLs would 301 to a host
# that does not exist, which is worse than a 404 (crawlers move the accumulated link equity to a dead
# address). It must be an absolute origin with scheme and no trailing slash, and it must actually resolve.
# NEXT_PUBLIC_LANDING_URL=https://poolroost.com

# Optional — pin the published image instead of tracking `latest`. Rollback path: set these to the
# sha-<commit> tag that release.yml published and re-run scripts/bootstrap.sh.
# APP_IMAGE_TAG=latest
# DASHBOARD_IMAGE_TAG=latest

# Which compose overlays scripts/bootstrap.sh adds when invoked with no arguments. The deploy mode is a
# property of the host, not of the command line: bootstrap.sh is also the redeploy/rollback path, so a
# later bare `./scripts/bootstrap.sh` on a TLS host would silently drop HTTPS. Set this once and every
# re-run keeps the mode. (A downgrade guard refuses the plaintext re-run anyway, but this avoids hitting
# it.) Space-separated; CLI arguments take precedence.
# DEPLOY_OVERLAYS=compose.prod.tls.yaml
# 풀 기반 배포 (#15). 서버의 systemd 타이머가 scripts/pull-deploy.sh 를 주기적으로 실행해
# origin/main 의 새 커밋을 스스로 가져와 배포한다 — GitHub 이 SSH 로 들어오지 않으므로 22 번을
# 좁힌 상태를 유지할 수 있다. 설치는 scripts/install-pull-deploy.sh, 자세한 배경은
# docs/engineering/deployment.md "자동 배포" 절 참고.
#
# ENABLED 가 true 가 아니면 스크립트는 아무것도 하지 않는다(fail closed). 타이머를 지우지 않고
# 배포만 멈추는 킬 스위치이기도 하다. 로컬 개발에는 필요 없다.
PULL_DEPLOY_ENABLED=false
# PULL_DEPLOY_BRANCH=main
# 공백으로 구분한 목록 — **전부** 200 이어야 배포 성공으로 본다. app 과 dashboard 는 별개 컨테이너라
# /actuator/health 하나만 보면 대시보드가 502 여도 배포가 성공으로 끝난다.
# PULL_DEPLOY_HEALTH_URLS="https://app.poolroost.com/actuator/health https://app.poolroost.com/login"

# ── 디스크 보존(retention) ──────────────────────────────────────────────────────
# 대부분 자동정리가 이미 켜져 있다: score_sample 은 기본 7일 롤링 퍼지(reputation-pool.score.retention),
# 백업은 BACKUP_RETENTION_DAYS(기본 7일), 컨테이너 로그는 30MB 로테이션, 배포 이미지는 pull-deploy 가
# scripts/prune-images.sh 로 정리한다. 유일하게 opt-in 인 것이 **감사 트레일**이다 —
# audit_event 는 기본(P0D)이 "영구 보존"이라 시간이 지나면 계속 쌓인다(Register/Report 는 기록하지
# 않고 cool/block 등 상태 전이만 남으므로 증가는 느리지만, 무한하다). 아래로 자동 퍼지를 켠다.
# REPUTATION_POOL_AUDIT_RETENTION=P30D   # 30일 지난 감사 이벤트 자동 삭제(미설정 시 영구 보존)
