# reputation-pool-cloud 한 오리진 서빙 (#15 / D8 슬라이스).
# 브라우저는 Caddy 하나만 보면 된다: /api·/actuator는 백엔드(app:8083)로, 나머지는 대시보드(Next
# standalone, dashboard:3000)로 라우팅한다. 대시보드와 API가 same-origin이 되므로 CORS가 필요 없다
# (dev의 next rewrite를 prod에서 대체). TLS·도메인·인증서는 #15의 후속(여기선 :80 평문 한 오리진만).
{
	admin off
	# 로컬/사내 평문. 실제 도메인 붙일 때 이 블록을 지우고 site address를 도메인으로 바꾸면 Caddy가
	# 자동 HTTPS를 켠다(#15 후속).
	auto_https off
}

# 백엔드 프록시 규칙. `/api` 와 `/actuator` 두 곳에서 같은 헤더 처리를 해야 하므로 스니펫으로 묶는다.
# (Caddyfile.prod 와 동일하게 유지할 것 — 갈리면 로컬과 프로덕션 동작이 달라진다.)
(backend) {
	reverse_proxy app:8083 {
		# X-Forwarded-For 를 클라이언트가 보낸 값과 무관하게 실제 peer IP 로 덮어쓴다(기본은 append).
		# 로컬에서는 무해하지만, 이 파일은 `compose.prod.yaml`(도메인 없이 평문 :80 공개)에서도 쓰이므로
		# 안전한 기본값이어야 한다 — append 로 두면 아무나 XFF 를 위조해 로그인 스로틀(#28)을 우회하거나
		# 타 IP 를 락아웃시킬 수 있다(Spring 의 ForwardedHeaderFilter 가 첫 항목을 채택한다).
		#
		# Caddy 는 이 줄에 "Unnecessary header_up X-Forwarded-For" 경고를 낸다 — 헤더를 그냥 전달하려는
		# 중복 설정으로 흔히 쓰이기 때문이다. 여기 의도는 전달이 아니라 **덮어쓰기**이므로 경고는 무시한다.
		# 실측으로 확인했다: 위조 XFF 를 실어 보내도 앱 로그의 소스 IP 는 실제 peer 이고 위조값은 나타나지
		# 않는다. 경고를 근거로 이 줄을 지우면 스로틀 우회 구멍이 되살아난다.
		header_up X-Forwarded-For {remote_host}
	}
}

# 로케일 자동 판별(#110) 경로의 `Vary`. `/login` 은 응답 본문이 `Accept-Language`·`rp_locale` 쿠키·
# `CF-IPCountry` 에 따라 달라지므로, 중간 캐시가 한 언어 응답을 다른 언어 방문자에게 주지 않도록
# 알려야 한다.
#
# 왜 앱이 아니라 Caddy 에서 붙이는가: Next 15.5 는 app-router 페이지 응답의 `Vary` 를 자신의 RSC 값
# (`rsc, next-router-state-tree, …`)으로 **덮어쓴다**. middleware 로 넣어도, `next.config.ts` 의
# `headers()` 로 넣어도 200 응답에서는 사라진다(실측 확인, `dashboard/middleware.ts` 주석 참고).
# 그래서 캐시 경계 바로 앞인 리버스 프록시에서 붙인다 — 여기 붙이면 Caddy 자신과 그 앞의 Cloudflare가
# 모두 본다. `+` 는 기존 값을 지우지 않고 필드를 추가한다(앱의 RSC Vary 를 날리면 클라이언트 라우터
# 캐시가 깨진다).
#
# `/` 는 여기서 빠졌다(#15): 랜딩이 apex(`landing/`, Cloudflare Pages)로 옮겨가면서 이 호스트의 `/` 는
# 언어에 따라 본문이 갈리는 페이지가 아니라 **고정 301**(`next.config.ts` 의 `redirects()`)이 되었다.
# 응답이 갈리지 않는 경로에 `Vary` 를 붙이면 캐시 키만 불필요하게 쪼개진다. 언어 판별은 이제 apex 쪽
# `landing/functions/_middleware.ts` 가 한다.
#
# (Caddyfile.prod 와 동일하게 유지할 것.)
(locale_vary) {
	header /login +Vary "Accept-Language, Cookie, CF-IPCountry"
}

# 오리진 다운 화면 (#134). dashboard 컨테이너가 죽으면 `reverse_proxy` 가 502 를 내는데, 지금까지는
# **본문 없는 502** 였다 — 브라우저는 빈 화면을 그린다. 앱이 죽어도 Caddy 는 살아 있으므로 이 순간
# 사용자에게 의미 있는 화면을 줄 수 있는 유일한 자리가 여기다.
#
# 화면 자체는 `caddy/origin-down.html`(compose 가 /srv/caddy 로 마운트)이고, 오리진에 아무것도
# 요청하지 않는 자족 HTML 이다.
#
# ## 왜 별도 파일인가(Caddyfile 안에 heredoc 으로 넣지 않은 이유)
# Caddyfile 은 `{...}` 를 플레이스홀더로 해석한다. 인라인 CSS 를 그대로 넣으면 중괄호를 전부
# `{{`/`}}` 로 이스케이프해야 하고, 그러면 사람이 읽지도 고치지도 못하는 덩어리가 된다. 파일로 빼면
# 브라우저로 직접 열어 확인할 수도 있다. 대신 compose 에 마운트가 하나 늘었다(`./caddy:/srv/caddy`) —
# `compose.prod.tls.yaml` 은 volumes 를 `!override` 로 통째 교체하므로 거기에도 함께 적어야 한다.
#
# ## 왜 한 파일에 한국어·영어를 병기하나
# Caddy 로도 `Accept-Language` 분기는 가능하지만, 그러려면 페이지를 언어 수만큼 복제하고 에러 응답에
# `Vary` 를 관리해야 한다. 앱이 죽어 있는 경로에 캐시 정합성 문제를 새로 만드는 대가로 얻는 것이
# "두 줄 중 한 줄이 사라지는 것" 뿐이라 병기를 골랐다(대시보드 404 는 앱이 살아 있으므로 기존 로케일
# 판별을 그대로 쓴다 — `dashboard/app/not-found.tsx`).
#
# ## 계층 분리(#15/#16) 후
# 랜딩이 별도 호스팅으로 나가면 "이 오리진이 죽어도 랜딩은 살아 있다" 가 된다. 그때는 HTML 의 CTA
# href 를 랜딩 절대 URL 로 바꾸고 문구를 그쪽으로 안내하게 옮기면 된다 — 그 변경이 한 줄로 끝나도록
# CTA 는 링크 하나만 두었다.
#
# `handle_errors` 는 **모든** 에러를 삼킨다. 502/503/504 만 처리하고 끝내면 나머지(예: 파일 없음)는
# 본문도 상태코드도 없는 응답이 되므로, 매칭되지 않는 경우를 위한 기본 handle 을 반드시 남긴다.
#
# (Caddyfile.prod 와 동일하게 유지할 것.)
(origin_down) {
	handle_errors {
		# 오리진에 닿지 못했거나(502) 대기열이 가득했거나(503) 응답이 늦은(504) 경우 — 셋 다 사용자에게는
		# "지금은 안 된다, 곧 된다" 로 같은 뜻이다. 4xx 는 앱이 직접 응답하므로 여기 오지 않는다.
		@origin_down expression {err.status_code} in [502, 503, 504]
		handle @origin_down {
			root * /srv/caddy
			rewrite * /origin-down.html
			# 본문의 `{{placeholder "http.error.status_code"}}` 를 실제 코드로 채운다. 정적 파일이라
			# 502/503/504 를 구분해 보여줄 방법이 이것뿐이다.
			templates
			# 장애 화면이 캐시에 남아 복구된 뒤에도 계속 보이는 사고를 막는다. 검색 색인도 함께 차단
			# (HTML 의 meta robots 는 크롤러가 본문을 파싱해야 보이지만 이 헤더는 그 전에 보인다).
			header Cache-Control "no-store"
			header X-Robots-Tag "noindex, nofollow"
			file_server {
				# 200 으로 내려가면 모니터링·크롤러·`curl -f` 가 전부 정상으로 오판한다. 원래 코드를 유지한다.
				status {err.status_code}
			}
		}
		handle {
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}
}

:80 {
	# REST 컨트롤 플레인 (#11).
	handle /api/* {
		import backend
	}
	# 내부 전용(#14): 프로메테우스 스크레이프는 외부(:80)로 노출하지 않는다. app 은 loopback 바인딩이고
	# Spring Security 에서 이 엔드포인트는 permitAll 이라, 신뢰 경계는 네트워크다 — compose 네트워크의
	# Prometheus 만 app:8083 을 직접 긁고, Caddy 를 통한 외부 접근은 404 로 막는다. (health/info 아래로 유지)
	handle /actuator/prometheus* {
		respond 404
	}
	# actuator health/info (public) — 화면6 헬스 카드가 same-origin으로 조회.
	handle /actuator/* {
		import backend
	}
	# 그 외 전부 대시보드.
	handle {
		import locale_vary
		reverse_proxy dashboard:3000
	}

	import origin_down
}
