# reputation-pool-cloud 한 오리진 서빙 (#15 / D8 슬라이스).
# 브라우저는 Caddy 하나만 보면 된다: /api·/actuator는 백엔드(app:8083)로, 나머지는 대시보드(Next
# standalone, dashboard:3000)로 라우팅한다. 대시보드와 API가 same-origin이 되므로 CORS가 필요 없다
# (dev의 next rewrite를 prod에서 대체). TLS·도메인·인증서는 #15의 후속(여기선 :80 평문 한 오리진만).
{
	admin off
	# 로컬/사내 평문. 실제 도메인 붙일 때 이 블록을 지우고 site address를 도메인으로 바꾸면 Caddy가
	# 자동 HTTPS를 켠다(#15 후속).
	auto_https off
}

# 백엔드 프록시 규칙. `/api` 와 `/actuator` 두 곳에서 같은 헤더 처리를 해야 하므로 스니펫으로 묶는다.
# (Caddyfile.prod 와 동일하게 유지할 것 — 갈리면 로컬과 프로덕션 동작이 달라진다.)
(backend) {
	reverse_proxy app:8083 {
		# X-Forwarded-For 를 클라이언트가 보낸 값과 무관하게 실제 peer IP 로 덮어쓴다(기본은 append).
		# 로컬에서는 무해하지만, 이 파일은 `compose.prod.yaml`(도메인 없이 평문 :80 공개)에서도 쓰이므로
		# 안전한 기본값이어야 한다 — append 로 두면 아무나 XFF 를 위조해 로그인 스로틀(#28)을 우회하거나
		# 타 IP 를 락아웃시킬 수 있다(Spring 의 ForwardedHeaderFilter 가 첫 항목을 채택한다).
		#
		# Caddy 는 이 줄에 "Unnecessary header_up X-Forwarded-For" 경고를 낸다 — 헤더를 그냥 전달하려는
		# 중복 설정으로 흔히 쓰이기 때문이다. 여기 의도는 전달이 아니라 **덮어쓰기**이므로 경고는 무시한다.
		# 실측으로 확인했다: 위조 XFF 를 실어 보내도 앱 로그의 소스 IP 는 실제 peer 이고 위조값은 나타나지
		# 않는다. 경고를 근거로 이 줄을 지우면 스로틀 우회 구멍이 되살아난다.
		header_up X-Forwarded-For {remote_host}
	}
}

# 로케일 자동 판별(#110) 경로의 `Vary`. `/` 와 `/login` 은 응답 본문이 `Accept-Language`·`rp_locale`
# 쿠키·`CF-IPCountry` 에 따라 달라지므로, 중간 캐시가 한 언어 응답을 다른 언어 방문자에게 주지 않도록
# 알려야 한다.
#
# 왜 앱이 아니라 Caddy 에서 붙이는가: Next 15.5 는 app-router 페이지 응답의 `Vary` 를 자신의 RSC 값
# (`rsc, next-router-state-tree, …`)으로 **덮어쓴다**. middleware 로 넣어도, `next.config.ts` 의
# `headers()` 로 넣어도 200 응답에서는 사라진다(실측 확인, `dashboard/middleware.ts` 주석 참고).
# 그래서 캐시 경계 바로 앞인 리버스 프록시에서 붙인다 — 여기 붙이면 Caddy 자신과 그 앞의 Cloudflare가
# 모두 본다. `+` 는 기존 값을 지우지 않고 필드를 추가한다(앱의 RSC Vary 를 날리면 클라이언트 라우터
# 캐시가 깨진다).
#
# 307 리다이렉트(`/` → `/ko`) 응답에는 앱이 넣은 같은 값이 이미 남아 있어 `Vary` 가 두 번 출력된다.
# `Vary` 는 목록 헤더라 중복은 합쳐져 해석되므로 무해하다.
#
# (Caddyfile.prod 와 동일하게 유지할 것.)
(locale_vary) {
	header / +Vary "Accept-Language, Cookie, CF-IPCountry"
	header /login +Vary "Accept-Language, Cookie, CF-IPCountry"
}

:80 {
	# REST 컨트롤 플레인 (#11).
	handle /api/* {
		import backend
	}
	# 내부 전용(#14): 프로메테우스 스크레이프는 외부(:80)로 노출하지 않는다. app 은 loopback 바인딩이고
	# Spring Security 에서 이 엔드포인트는 permitAll 이라, 신뢰 경계는 네트워크다 — compose 네트워크의
	# Prometheus 만 app:8083 을 직접 긁고, Caddy 를 통한 외부 접근은 404 로 막는다. (health/info 아래로 유지)
	handle /actuator/prometheus* {
		respond 404
	}
	# actuator health/info (public) — 화면6 헬스 카드가 same-origin으로 조회.
	handle /actuator/* {
		import backend
	}
	# 그 외 전부 대시보드.
	handle {
		import locale_vary
		reverse_proxy dashboard:3000
	}
}
